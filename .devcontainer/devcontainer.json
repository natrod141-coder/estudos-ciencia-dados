{
  "name": "estudos",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "npm install && pip install -r desafios/requirements.txt --break-system-packages",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "astro-build.astro-vscode"
      ]
    }
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Site (npm run dev)" }
  }
}
